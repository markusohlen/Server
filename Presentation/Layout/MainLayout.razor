@inherits LayoutComponentBase

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="header-stack">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenText TextStyle="TextStyle.H6" class="app-title">Meal Planner</RadzenText>
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="@sidebarExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home" Path="" Icon="home" />
            <RadzenPanelMenuItem Text="Meals" Path="meals" Icon="restaurant_menu" />
            <RadzenPanelMenuItem Text="Add Recipe" Path="meals/add" Icon="add" />
            <RadzenPanelMenuItem Text="Recipe Nutrition" Path="recipe-nutrition" Icon="science" />
            <RadzenPanelMenuItem Text="Videos" Path="videos" Icon="smart_display" />
            <RadzenPanelMenuItem Text="Add Video" Path="videos/add" Icon="video_call" />
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        <div class="body-content">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>
